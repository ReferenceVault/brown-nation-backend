# ==============================
# App
# ==============================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# ==============================
# Database (PostgreSQL via Prisma)
# ==============================
DATABASE_URL=postgresql://brown_nation:brown_nation@localhost:55432/brown_nation?schema=public

# ==============================
# JWT
# ==============================
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password reset tokens
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Email verification tokens
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440

# ==============================
# CORS (comma-separated list of allowed origins)
# ==============================
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# ==============================
# Rate limiting
# ==============================
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ==============================
# Logging
# ==============================
LOG_LEVEL=debug

# ==============================
# Swagger
# ==============================
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# ==============================
# Object storage (S3-compatible: AWS S3 / Cloudflare R2 / MinIO)
# ==============================
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=brown-nation-media
S3_ACCESS_KEY=brownnation
S3_SECRET_KEY=brownnation123
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:59000/brown-nation-media

# ==============================
# Payments
# ==============================
# "mock" (default, safe for local dev), "stripe", or "razorpay"
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay (https://dashboard.razorpay.com/app/keys — Test mode for local dev)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set under Dashboard > Account & Settings > Webhooks when adding the webhook URL
RAZORPAY_WEBHOOK_SECRET=

# ==============================
# Email
# ==============================
# "mock" (logs emails, default for local dev), "smtp", or "resend"
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@brownnation.com

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@brownnation.in

# Where contact-form enquiry notifications are sent
CONTACT_NOTIFICATION_EMAIL=brownnation.choco@gmail.com
