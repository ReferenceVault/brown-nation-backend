# ==============================
# App
# ==============================
NODE_ENV=test
PORT=3100
APP_URL=http://localhost:3100
FRONTEND_URL=http://localhost:3001

# ==============================
# Database (PostgreSQL via Prisma) - separate test database
# ==============================
DATABASE_URL=postgresql://brown_nation:brown_nation@localhost:55432/brown_nation_test?schema=public

# ==============================
# JWT
# ==============================
JWT_ACCESS_SECRET=test-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=test-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# ==============================
# CORS
# ==============================
CORS_ORIGIN=http://localhost:3001

# ==============================
# Rate limiting (disabled in test env via skipIf, values unused)
# ==============================
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=1000

# ==============================
# Logging
# ==============================
LOG_LEVEL=silent

# ==============================
# Swagger
# ==============================
SWAGGER_ENABLED=false
SWAGGER_PATH=docs

# ==============================
# Object storage
# ==============================
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=brown-nation-media-test
S3_ACCESS_KEY=brownnation
S3_SECRET_KEY=brownnation123
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:59000/brown-nation-media-test

# ==============================
# Payments
# ==============================
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ==============================
# Email
# ==============================
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@brownnation.com
